<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Read-only SMS access for transaction capture (intent 001-sms-transaction-capture).
        SEND_SMS is intentionally never declared or requested anywhere in this app.
    -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <application
        android:name=".SmsExpenseTrackerApp"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:theme="@style/Theme.SmsExpenseTracker"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SmsExpenseTracker">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Read-only observer of incoming SMS (bolt 002-sms-ingestion). Restricted to senders
            holding BROADCAST_SMS (system-only) so other apps can't spoof this broadcast to us.
            SMS_RECEIVED_ACTION is exempted from Android 8+'s implicit-broadcast manifest
            restrictions, so a static receiver remains valid at minSdk 26.
        -->
        <receiver
            android:name=".smsingestion.data.receiver.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
